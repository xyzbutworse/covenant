# --- Wallet: use a fresh test-only key ---
CREDITCOIN_WALLET_PRIVATE_KEY=

# --- Creditcoin / Attestcoin execution environment ---
# VERIFIED LIVE (see evidence/network-probe.json): CC3 Testnet, chainId 102031,
# 0x0FD2/0x0FD3 precompiles serving Sepolia chainKey=1. Source of truth:
# https://github.com/gluwa/attestcoin-protocol-examples
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
COVENANT_CONTRACT_ADDRESS=

# --- Ethereum source chain ---
# Use the same address as the Creditcoin borrower if you want this payment to satisfy the covenant.
SOURCE_WALLET_PRIVATE_KEY=
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_NAME=Ethereum Sepolia
SOURCE_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Demo obligation
DEMO_FACILITY_ID=
DEMO_COVENANT_ID=
DEMO_PAYMENT_RECIPIENT=
DEMO_REQUIRED_USDC=5000000
DEMO_CREDIT_LIMIT_CTC=10
DEMO_TRANCHE_CTC=2
DEMO_SOURCE_WINDOW_BLOCKS=100
DEMO_PROOF_DEADLINE_BLOCKS=300
# Attestcoin frontier must advance this many source blocks past the covenant window
# before a missed-deadline freeze is permitted (borrower protection).
DEMO_FREEZE_FRONTIER_MARGIN_BLOCKS=50
DEMO_FACILITY_MATURITY_BLOCKS=1200

# Worker inputs
SOURCE_TX_HASH=
PROOF_FILE=./evidence/happy-path/proof.json
# 'fresh' (default): submit.ts regenerates the proof immediately before submission.
# 'file': submits the existing PROOF_FILE artifact after a staleness check.
PROOF_SOURCE=fresh
PROOF_MAX_AGE_SECONDS=900
# Optional distinct gas payer for evidence submission (permissionless on-chain anyway).
SUBMITTER_PRIVATE_KEY=
